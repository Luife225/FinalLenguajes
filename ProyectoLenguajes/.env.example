# Copia este archivo como .env para desarrollo local. No publiques el .env real.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
RAWG_API_KEY=your-rawg-api-key
GROQ_API_KEY=your-groq-api-key

# SQLite local. En Render se usa DB_ENGINE=postgresql y las variables DB_*.
DB_ENGINE=sqlite3
# DB_NAME=postgres
# DB_USER=postgres.project-ref
# DB_PASSWORD=your-database-password
# DB_HOST=your-session-pooler-host
# DB_PORT=5432
